# Backend Environment Variables Template
# Copy this to .env and fill in your actual values

# Node Environment
NODE_ENV=production

# Server Port
PORT=5000

# MongoDB Connection String
# Get this from MongoDB Atlas: https://cloud.mongodb.com
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/mindcare?retryWrites=true&w=majority

# JWT Secret Key (use a strong random string)
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Google Gemini API Configuration
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# Frontend Origin (comma-separated for multiple origins)
# Example: https://your-app.vercel.app,https://your-app-staging.vercel.app
FRONTEND_ORIGIN=http://localhost:5173
